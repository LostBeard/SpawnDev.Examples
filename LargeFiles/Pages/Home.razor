@page "/"
@inject SpawnJSRuntime JS
@implements IAsyncDisposable

<main>
    <h1>Where does the file go?</h1>
    <p>Both buttons save the same file to this browser's private storage, then delete it. Compare how much .NET memory each one takes.</p>
    <p><label>Your own file, or leave empty for a @SizeMB MB test file: <input id="pick" type="file" /></label></p>
    <button id="copy" disabled="@busy" @onclick="() => Run(SaveThroughDotNet)">Save through .NET</button>
    <button id="stream" disabled="@busy" @onclick="() => Run(SaveStream)">Stream it</button>
    <p id="result" role="status">@result</p>
    <h2>Play a video from storage</h2>
    <p>Saves a video to storage and plays it from there. Leave the file above empty to use a 30 second Big Buck Bunny clip.</p>
    <button id="play" disabled="@busy" @onclick="PlayFromStorage">Play it</button>
    @if (videoUrl is not null)
    {
        <p><video id="video" src="@videoUrl" controls autoplay muted></video></p>
    }
    <p><small>Big Buck Bunny (c) 2008 Blender Foundation, <a href="https://peach.blender.org">peach.blender.org</a>. Sunflower version by Janus Bager Kristensen, 2013. <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>.</small></p>
</main>

@code {
    const int SizeMB = 200;
    const string FileName = "test.bin";
    const string VideoName = "video";
    string? videoUrl;
    bool busy;
    string result = "";

    // The usual way: the whole file becomes a byte[] in .NET.
    async Task<long> SaveThroughDotNet(Blob file, FileSystemWritableFileStream target)
    {
        using var buffer = await file.ArrayBuffer();
        byte[] bytes = buffer.ReadBytes();
        var used = GC.GetTotalMemory(false);
        await target.Write(bytes);
        await target.Close();
        return used;
    }

    // The browser moves the bytes. .NET only says where from and where to.
    async Task<long> SaveStream(Blob file, FileSystemWritableFileStream target)
    {
        using var stream = file.Stream();
        await stream.PipeTo(target); // also closes the target
        return GC.GetTotalMemory(false);
    }

    async Task Run(Func<Blob, FileSystemWritableFileStream, Task<long>> save)
    {
        busy = true;
        result = "Saving...";
        await Task.Delay(50); // let the page draw
        try
        {
            using var file = GetChosenFile() ?? MakeTestFile();
            using var navigator = new Navigator();
            using var storage = navigator.Storage;
            using var folder = await storage.GetDirectory();
            using var handle = await folder.GetFileHandle(FileName, create: true);
            using var target = await handle.CreateWritable();

            GC.Collect();
            var before = GC.GetTotalMemory(true);
            var after = await save(file, target);

            using var saved = await handle.GetFile();
            result = $"Saved {saved.Size / 1048576.0:F1} MB. .NET memory grew by {Math.Max(0, after - before) / 1048576.0:F1} MB.";
            await folder.RemoveEntry(FileName);
        }
        catch (Exception ex)
        {
            result = $"Could not save: {ex.Message}";
        }
        GC.Collect();
        busy = false;
    }

    async Task PlayFromStorage()
    {
        busy = true;
        result = "Saving...";
        await StopVideo();
        try
        {
            using var file = GetChosenFile() ?? await GetSampleVideo();
            using var navigator = new Navigator();
            using var storage = navigator.Storage;
            using var folder = await storage.GetDirectory();
            using var handle = await folder.GetFileHandle(VideoName, create: true);
            using var target = await handle.CreateWritable();

            GC.Collect();
            var before = GC.GetTotalMemory(true);
            using var stream = file.Stream();
            await stream.PipeTo(target);

            using var saved = await handle.GetFile();
            videoUrl = URL.CreateObjectURL(saved);
            result = $"Playing {saved.Size / 1048576.0:F1} MB from storage. .NET memory grew by {Math.Max(0, GC.GetTotalMemory(false) - before) / 1048576.0:F1} MB.";
        }
        catch (Exception ex)
        {
            result = $"Could not play: {ex.Message}";
        }
        busy = false;
    }

    // Even the download stays in the browser: the response becomes a Blob, not a byte[].
    async Task<Blob> GetSampleVideo()
    {
        using var response = await JS.Fetch("BigBuckBunny-30.mp4");
        if (!response.Ok) throw new Exception("no sample video found, choose a file instead");
        return await response.Blob();
    }

    // An object URL keeps its file in use until it is revoked.
    async Task StopVideo()
    {
        if (videoUrl is null) return;
        URL.RevokeObjectURL(videoUrl);
        videoUrl = null;
        using var navigator = new Navigator();
        using var storage = navigator.Storage;
        using var folder = await storage.GetDirectory();
        await folder.RemoveEntry(VideoName);
    }

    public async ValueTask DisposeAsync() => await StopVideo();

    Blob? GetChosenFile()
    {
        using var document = JS.GetDocument()!;
        using var input = document.GetElementById<HTMLInputElement>("pick")!;
        using var files = input.Files;
        return files?.FirstOrDefault();
    }

    // One MB of data, repeated. The browser holds it; nothing large is made in .NET.
    static Blob MakeTestFile()
    {
        using var block = new Blob(new[] { new byte[1048576] });
        return new Blob(Enumerable.Repeat(block, SizeMB));
    }
}
